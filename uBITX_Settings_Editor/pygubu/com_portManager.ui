<?xml version='1.0' encoding='utf-8'?>
<interface version="1.3">
  <object class="ttk.Frame" id="selectComPortFrame" named="True">
    <property name="height">200</property>
    <property name="width">200</property>
    <layout manager="pack">
      <property name="anchor">w</property>
      <property name="side">top</property>
    </layout>
    <child>
      <object class="ttk.Combobox" id="comPortsOptionMenu" named="True">
        <property name="textvariable">string:availableComPorts</property>
        <property name="values">{Select Serial Port}</property>
        <property name="width">20</property>
        <bind sequence="&lt;&lt;ComboboxSelected&gt;&gt;" handler="comPortSelected" add="" />
        <bind sequence="&lt;FocusOut&gt;" handler="comPortTyped" add="" />
        <bind sequence="&lt;KeyRelease&gt;" handler="comPortTyped" add="" />
        <bind sequence="&lt;Return&gt;" handler="comPortTyped" add="" />
        <layout manager="grid">
          <property name="column">0</property>
          <property name="padx">0 5</property>
          <property name="row">0</property>
          <property name="sticky">w</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Button" id="comPortListRefresh" named="True">
        <property name="borderwidth">0</property>
        <property name="command" type="command" cbtype="simple">updateComPorts</property>
        <property name="cursor">arrow</property>
        <property name="font">TkDefaultFont</property>
        <layout manager="grid">
          <property name="column">1</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
